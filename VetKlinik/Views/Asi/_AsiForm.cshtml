@model AsiFormVM

<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

<div class="mb-3">
    <label asp-for="AsiAdi" class="form-label"></label>
    <input asp-for="AsiAdi" class="form-control" list="asiAdlari" />
    <datalist id="asiAdlari">
        <option value="Karma Aşı"></option>
        <option value="Kuduz"></option>
        <option value="Lösemi (FeLV)"></option>
        <option value="Bronşin"></option>
        <option value="Lyme"></option>
        <option value="İç Parazit"></option>
        <option value="Dış Parazit"></option>
    </datalist>
    <span asp-validation-for="AsiAdi" class="small"></span>
</div>
<div class="row">
    <div class="col-sm-6 mb-3">
        <label asp-for="YapildigiTarih" class="form-label"></label>
        <input asp-for="YapildigiTarih" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="YapildigiTarih" class="small"></span>
    </div>
    <div class="col-sm-6 mb-3">
        <label asp-for="SonrakiDozTarihi" class="form-label"></label>
        <input asp-for="SonrakiDozTarihi" class="form-control" />
        <span asp-validation-for="SonrakiDozTarihi" class="small"></span>
        <div class="form-text">Tekrar dozu yoksa boş bırakın.</div>
    </div>
</div>
