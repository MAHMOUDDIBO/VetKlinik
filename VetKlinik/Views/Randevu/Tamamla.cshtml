@model RandevuTamamlaVM
@{
    var r = (Randevu)ViewData["Randevu"]!;
}

<h1 class="h3">Muayene notu</h1>
<p class="text-muted">
    @r.EvcilHayvan.EvcilHayvanAdi (@r.EvcilHayvan.Tur) · @r.Hizmet.HizmetAdi ·
    @r.Baslangic.ToString("dd.MM.yyyy HH:mm") · Sahibi: @r.EvcilHayvan.Sahip.AdSoyad
</p>

<form asp-action="Tamamla" asp-route-id="@r.RandevuId" method="post" class="col-lg-8">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
    <div class="mb-3">
        <label asp-for="MuayeneNotu" class="form-label"></label>
        <textarea asp-for="MuayeneNotu" class="form-control" rows="7"
                  placeholder="Bulgular, uygulanan tedavi, öneriler..."></textarea>
        <span asp-validation-for="MuayeneNotu" class="small"></span>
    </div>
    <button type="submit" class="btn btn-primary">Kaydet ve tamamla</button>
    <a asp-action="Detay" asp-route-id="@r.RandevuId" class="btn btn-link">Vazgeç</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
