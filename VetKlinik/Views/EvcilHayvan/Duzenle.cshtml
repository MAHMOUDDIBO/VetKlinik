@model EvcilHayvanFormVM

<h1 class="h3">Bilgileri düzenle</h1>

<form asp-action="Duzenle" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post" class="col-lg-7">
    <partial name="_EvcilHayvanForm" model="Model" />
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Detay" asp-route-id="@ViewContext.RouteData.Values["id"]" class="btn btn-link">Vazgeç</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
