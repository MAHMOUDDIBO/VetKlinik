@model List<Veteriner>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Veteriner Hekimler</h1>
    @if (User.IsInRole(Roller.Admin))
    {
        <a asp-action="Ekle" class="btn btn-primary">+ Yeni hekim</a>
    }
</div>

<div class="row g-3">
    @foreach (var v in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="h5 mb-1">Vet. Hek. @v.VeterinerAdSoyad</h2>
                    <p class="text-klinik small mb-2">@v.UzmanAlani</p>
                    <p class="small mb-2">
                        @foreach (var h in v.Hizmetler.OrderBy(h => h.HizmetAdi))
                        {
                            <span class="badge bg-light text-dark border me-1">@h.HizmetAdi</span>
                        }
                    </p>
                    <p class="small text-muted mb-0">
                        @(v.Musaitlikler.Count == 0 ? "Çalışma saati tanımlı değil" :
                          string.Join(" · ", v.Musaitlikler.OrderBy(m => ((int)m.Gun + 6) % 7).ThenBy(m => m.Baslangic)
                              .Select(m => $"{GunAdlari.Ad(m.Gun)} {m.Baslangic:HH\\:mm}–{m.Bitis:HH\\:mm}")))
                    </p>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <a asp-action="Detay" asp-route-id="@v.VeterinerId" class="btn btn-sm btn-outline-primary">Detay</a>
                </div>
            </div>
        </div>
    }
</div>
