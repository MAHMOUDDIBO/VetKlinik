@model VeterinerFormVM
@{
    var hizmetler = (List<Hizmet>)ViewData["Hizmetler"]!;
}

<div class="mb-3">
    <label asp-for="VeterinerAdSoyad" class="form-label"></label>
    <input asp-for="VeterinerAdSoyad" class="form-control" />
    <span asp-validation-for="VeterinerAdSoyad" class="small"></span>
</div>

<div class="mb-3">
    <label asp-for="UzmanAlani" class="form-label"></label>
    <input asp-for="UzmanAlani" class="form-control" list="uzmanliklar" />
    <datalist id="uzmanliklar">
        @foreach (var u in VeterinerFormVM.UzmanlikAlanlari)
        {
            <option value="@u"></option>
        }
    </datalist>
    <span asp-validation-for="UzmanAlani" class="small"></span>
</div>

<fieldset class="mb-3">
    <legend class="form-label fs-6">Verebildiği hizmetler</legend>
    @foreach (var h in hizmetler)
    {
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="checkbox" name="SecilenHizmetIdleri" value="@h.HizmetId"
                   id="hizmet-@h.HizmetId" checked="@Model.SecilenHizmetIdleri.Contains(h.HizmetId)" />
            <label class="form-check-label" for="hizmet-@h.HizmetId">@h.HizmetAdi</label>
        </div>
    }
</fieldset>
