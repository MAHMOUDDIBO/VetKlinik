@model VeterinerEkleVM

<h1 class="h3">Hekim ekle</h1>
<p class="text-muted">Hekim kaydıyla birlikte, hekimin randevularını yöneteceği bir giriş hesabı da oluşturulur.</p>

<form asp-action="Ekle" method="post" class="col-lg-7">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

    <partial name="_VeterinerForm" model="Model" />

    <h2 class="h6 mt-4">Giriş hesabı</h2>
    <div class="row">
        <div class="col-sm-7 mb-3">
            <label asp-for="Eposta" class="form-label"></label>
            <input asp-for="Eposta" class="form-control" />
            <span asp-validation-for="Eposta" class="small"></span>
        </div>
        <div class="col-sm-5 mb-3">
            <label asp-for="Sifre" class="form-label"></label>
            <input asp-for="Sifre" class="form-control" />
            <span asp-validation-for="Sifre" class="small"></span>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Index" class="btn btn-link">Vazgeç</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
