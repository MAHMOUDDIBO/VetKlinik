@model KayitVM

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-1">Üye ol</h1>
                <p class="text-muted small">Evcil hayvanlarınızı kaydedin ve online randevu alın.</p>

                <form asp-action="Kayit" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                    <div class="mb-3">
                        <label asp-for="AdSoyad" class="form-label"></label>
                        <input asp-for="AdSoyad" class="form-control" autocomplete="name" />
                        <span asp-validation-for="AdSoyad" class="small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Eposta" class="form-label"></label>
                        <input asp-for="Eposta" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Eposta" class="small"></span>
                    </div>
                    <div class="row">
                        <div class="col-sm-6 mb-3">
                            <label asp-for="Sifre" class="form-label"></label>
                            <input asp-for="Sifre" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Sifre" class="small"></span>
                        </div>
                        <div class="col-sm-6 mb-3">
                            <label asp-for="SifreTekrar" class="form-label"></label>
                            <input asp-for="SifreTekrar" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="SifreTekrar" class="small"></span>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Üye ol</button>
                </form>

                <p class="text-center mt-3 mb-0 small">Zaten üye misiniz? <a asp-action="Giris">Giriş yapın</a></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
