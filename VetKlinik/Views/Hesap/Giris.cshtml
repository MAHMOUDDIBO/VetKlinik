@model GirisVM

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-3">Giriş yap</h1>

                <form asp-action="Giris" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                    <input type="hidden" asp-for="DonusAdresi" />

                    <div class="mb-3">
                        <label asp-for="Eposta" class="form-label"></label>
                        <input asp-for="Eposta" class="form-control" autocomplete="username" />
                        <span asp-validation-for="Eposta" class="small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Sifre" class="form-label"></label>
                        <input asp-for="Sifre" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Sifre" class="small"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="BeniHatirla" class="form-check-input" />
                        <label asp-for="BeniHatirla" class="form-check-label"></label>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Giriş</button>
                </form>

                <p class="text-center mt-3 mb-0 small">Hesabınız yok mu? <a asp-action="Kayit">Üye olun</a></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
